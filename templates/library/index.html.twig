{% extends 'base.html.twig' %}

{% block title %}Ma bibliothèque{% endblock %}

{% block body %}
    <h1>Ma bibliothèque</h1>

    {% for message in app.flashes('success') %}
        <p class="flash-success">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <p class="flash-error">{{ message }}</p>
    {% endfor %}

    <section data-controller="book-search">
        <h2>Ajouter un livre</h2>

        <form method="post" action="{{ path('app_library_search') }}" data-turbo-frame="search-results" data-book-search-target="form">
            <input
                type="text"
                name="q"
                placeholder="Rechercher un livre par titre ou auteur..."
                autocomplete="off"
                data-action="input->book-search#search"
            >
            <input type="hidden" name="_token" value="{{ csrf_token('library_search') }}">
        </form>

        <turbo-frame id="search-results"></turbo-frame>
    </section>

    <section>
        <h2>Mes livres</h2>

        {% if userBooks is empty %}
            <p>Votre bibliothèque est vide pour le moment.</p>
        {% else %}
            <ul class="user-books">
                {% for userBook in userBooks %}
                    <li class="user-book">
                        {% if userBook.book.coverUrl %}
                            <img src="{{ userBook.book.coverUrl }}" alt="">
                        {% endif %}

                        <div>
                            <strong>{{ userBook.book.title }}</strong>
                            {% if userBook.book.authors is not empty %}
                                <span>{{ userBook.book.authors|join(', ') }}</span>
                            {% endif %}

                            <p>
                                Statut :
                                {{ {
                                    'to_read': 'À lire',
                                    'reading': 'En cours',
                                    'read': 'Lu',
                                    'abandoned': 'Abandonné',
                                }[userBook.status.value] }}
                            </p>

                            <form method="patch" action="{{ path('app_library_update_progress', {id: userBook.id}) }}">
                                <label for="progress-{{ userBook.id }}">Progression ({{ userBook.progress }}%)</label>
                                <input
                                    type="number"
                                    id="progress-{{ userBook.id }}"
                                    name="progress"
                                    min="0"
                                    max="100"
                                    value="{{ userBook.progress }}"
                                >
                                <input type="hidden" name="_token" value="{{ csrf_token('library_update_progress') }}">
                                <button type="submit">Mettre à jour</button>
                            </form>

                            <div class="reviews">
                                <h4>Avis</h4>
                                <ul>
                                    {% for review in reviewsByUserBookId[userBook.id] %}
                                        <li class="review">
                                            {% if review.containsSpoiler %}
                                                <button type="button" onclick="this.nextElementSibling.hidden = false; this.hidden = true;">
                                                    Révéler (contient un spoiler)
                                                </button>
                                                <p hidden>{{ review.text }}</p>
                                            {% else %}
                                                <p>{{ review.text }}</p>
                                            {% endif %}
                                            {% include 'report/_report_modal.html.twig' with {contentType: 'review', contentId: review.id} %}
                                        </li>
                                    {% else %}
                                        <li>Aucun avis pour le moment.</li>
                                    {% endfor %}
                                </ul>

                                <form method="post" action="{{ path('app_library_review', {id: userBook.id}) }}">
                                    <textarea name="text" required placeholder="Votre avis..."></textarea>
                                    <label>
                                        <input type="checkbox" name="containsSpoiler" value="1">
                                        Contient un spoiler
                                    </label>
                                    <input type="hidden" name="_token" value="{{ csrf_token('library_review') }}">
                                    <button type="submit">Publier l'avis</button>
                                </form>
                            </div>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
{% endblock %}
