<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\UserBook" table="user_books">
        <unique-constraints>
            <unique-constraint columns="user_id,book_id" name="uniq_user_book"/>
        </unique-constraints>

        <id name="id" type="integer">
            <generator strategy="IDENTITY"/>
        </id>

        <many-to-one field="user" target-entity="App\Domain\Entity\User">
            <join-column name="user_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="book" target-entity="App\Domain\Entity\Book">
            <join-column name="book_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <field name="status" type="string" column="status" length="20" nullable="false"
               enum-type="App\Domain\ValueObject\BookStatus"/>
        <field name="rating" type="integer" column="rating" nullable="true"/>
        <field name="progress" type="integer" column="progress" nullable="false"/>
        <field name="createdAt" type="datetime_immutable" column="created_at" nullable="false"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="false"/>
    </entity>
</doctrine-mapping>
