<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\Discussion" table="discussions">
        <id name="id" type="integer">
            <generator strategy="IDENTITY"/>
        </id>

        <many-to-one field="readingClub" target-entity="App\Domain\Entity\ReadingClub">
            <join-column name="reading_club_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <!-- null = channel global du club, toujours visible (cf. Règle métier centrale) -->
        <many-to-one field="chapter" target-entity="App\Domain\Entity\Chapter">
            <join-column name="chapter_id" referenced-column-name="id" nullable="true" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="author" target-entity="App\Domain\Entity\User">
            <join-column name="author_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <field name="text" type="text" column="text" nullable="false"/>
        <field name="createdAt" type="datetime_immutable" column="created_at" nullable="false"/>
    </entity>
</doctrine-mapping>
